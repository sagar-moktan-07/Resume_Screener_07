# Must be IDENTICAL to FASTAPI_API_KEY in the Spring Boot .env
SERVICE_API_KEY=

# Read-only database account created in SQL Step 2
DB_HOST=localhost
DB_PORT=5432
DB_NAME=resumedb
DB_USER=fastapi_reader
DB_PASSWORD=

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=300
OLLAMA_NUM_CTX=4096
# Leave blank for normal models. Set to false ONLY for "thinking" models (qwen3, qwen3.5).
OLLAMA_THINK=

# Ranking
TOP_N=7
WEIGHT_KEYWORD=0.4
WEIGHT_LLM=0.6
MAX_RESUME_CHARS=3500
AUTO_RANK_ON_DATA_READY=true